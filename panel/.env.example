# Copy to .env and fill in real values. .env is gitignored.

# --- Database (postgres container name matches docker-compose.yml service) ---
# NOTE: .env files are NOT shell scripts — there is no variable
# interpolation. POSTGRES_PASSWORD below is used by the postgres
# container itself; DATABASE_URL is a separate, fully-written
# connection string that the panel app reads. Keep the password
# identical in both places. install.sh fills in both automatically
# from a single generated password — you only need to edit these by
# hand if setting up without the install script.
POSTGRES_USER=awgrt
POSTGRES_PASSWORD=
POSTGRES_DB=awgrt
DATABASE_URL=postgresql+asyncpg://awgrt:REPLACE_WITH_SAME_PASSWORD_AS_ABOVE@postgres:5432/awgrt

# --- Redis ---
REDIS_URL=redis://redis:6379/0
PEER_CONFIG_TTL_SECONDS=172800

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=

# --- Monitoring thresholds (seconds) ---
MONITORING_INTERVAL_SECONDS=180
HANDSHAKE_STALE_AFTER_SECONDS=300
HANDSHAKE_DOWN_AFTER_SECONDS=900

# --- App ---
LOG_LEVEL=INFO
APP_ENV=production
