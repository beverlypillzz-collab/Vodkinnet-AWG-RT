# Copy this file to .env and fill in real values.
# .env is gitignored at the repo root — never commit it.

# --- Required ---

# Generate with: openssl rand -hex 32
# Must match exactly what the panel stores for this node's agent_token.
AGENT_TOKEN=

# Name of the AmneziaWG docker container on THIS host that this agent
# is allowed to exec into. Must match the `container_name:` in this
# node's docker-compose.yml (see ../docs/deployment.md).
AWG_CONTAINER_NAME=amnezia-awg2

# UDP port the AmneziaWG server listens on (must match the container's
# published port).
AWG_LISTEN_PORT=55632

# --- Optional ---

# Publicly reachable hostname/IP for this node. If left blank, the
# panel is responsible for substituting the real endpoint into
# generated client configs (see docs/api-contract.md).
AWG_PUBLIC_ENDPOINT=

# Only change if you're running a non-default AmneziaWG interface name.
AWG_INTERFACE=awg0

# LISTEN_HOST is only meaningful for a non-Docker deployment; the
# Docker image always binds 0.0.0.0 internally and relies on
# docker-compose's port mapping (127.0.0.1:8181:8181 on the host) to
# keep the agent unreachable from outside — see docs/deployment.md.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8181

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
